#!/usr/bin/env bash
# asmt-gate — run the repo's verification command and write a receipt keyed to
# HEAD. The receipt is the deliverable: it makes "verified" a fact about a
# specific tree rather than a claim in a transcript.
set -euo pipefail

die() { printf 'asmt-gate: %s\n' "$*" >&2; exit 1; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository."
CONFIG="$ROOT/.asmt/config.yml"
RECEIPTS="$ROOT/.asmt/receipts"
SHA="$(git -C "$ROOT" rev-parse HEAD)"
RECEIPT="$RECEIPTS/$SHA.json"

# ponytail: line-oriented read of one scalar, not a YAML parser. Requires
# `command:` indented under a top-level `verify:`. Swap for a real parser only
# if the config grows nested structures the gate has to read.
read_verify_command() {
  sed -n '/^verify:/,/^[^[:space:]#]/p' "$CONFIG" \
    | sed -n 's/^[[:space:]]\{1,\}command:[[:space:]]*//p' \
    | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}

# Same scalar-read trick for verify.timeout_seconds. Empty/missing/non-numeric
# all collapse to "0", and `timeout 0 ...` (GNU coreutils) means "no timeout"
# — so a config that omits the key runs exactly as before this was wired up.
read_verify_timeout() {
  sed -n '/^verify:/,/^[^[:space:]#]/p' "$CONFIG" \
    | sed -n 's/^[[:space:]]\{1,\}timeout_seconds:[[:space:]]*//p' \
    | head -n 1
}

cmd_run() {
  local cmd start result seconds esc matches n_matches timeout_secs
  [ -f "$CONFIG" ] || die "no .asmt/config.yml in $ROOT. Create one with a verify.command (see README)."
  matches="$(read_verify_command)" || die "could not read verify.command from $CONFIG"
  n_matches="$(printf '%s\n' "$matches" | grep -c '.')" || true
  case "$n_matches" in
    0) cmd="" ;;
    1) cmd="$matches" ;;
    *) die "ambiguous verify.command in $CONFIG ($n_matches matches)" ;;
  esac
  [ -n "$cmd" ] || die "verify.command missing from $CONFIG"
  [ -z "$(git -C "$ROOT" status --porcelain)" ] \
    || die "working tree dirty — commit before gating."

  timeout_secs="$(read_verify_timeout)"
  case "$timeout_secs" in *[!0-9]*|'') timeout_secs=0 ;; esac

  mkdir -p "$RECEIPTS"
  start="$(date +%s)"

  # `timeout` is GNU coreutils and macOS does not ship it. Calling it blind
  # made the subshell exit 127, so the gate wrote "result":"fail","seconds":0
  # having never run the verify command — a verdict about nothing. Resolve a
  # binary first, and when there is none, run the command anyway rather than
  # reporting a failure that never happened.
  #
  # ASMT_TIMEOUT_BIN is honoured if already set, which is how the tests
  # simulate a machine with neither binary.
  if [ -z "${ASMT_TIMEOUT_BIN+set}" ]; then
    ASMT_TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
  fi

  if [ -n "$ASMT_TIMEOUT_BIN" ]; then
    if ( cd "$ROOT" && "$ASMT_TIMEOUT_BIN" "$timeout_secs" bash -c "$cmd" ); then
      result=pass
    else
      result=fail
    fi
  else
    # A dropped timeout is a fact the operator needs. Saying so beats silently
    # downgrading a configured limit, and beats refusing to verify at all.
    [ "$timeout_secs" = 0 ] || printf 'asmt-gate: no timeout or gtimeout on PATH — running unbounded (verify.timeout_seconds: %s ignored).\n' "$timeout_secs" >&2
    if ( cd "$ROOT" && bash -c "$cmd" ); then result=pass; else result=fail; fi
  fi

  seconds="$(( $(date +%s) - start ))"

  # escape backslashes before quotes, so the receipt is valid JSON even when
  # verify.command contains literal backslashes (Windows paths, sed, regex).
  esc="${cmd//\\/\\\\}"
  esc="${esc//\"/\\\"}"
  printf '{"sha":"%s","result":"%s","command":"%s","at":"%s","seconds":%s}\n' \
    "$SHA" "$result" "$esc" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$seconds" > "$RECEIPT"

  [ "$result" = pass ] || die "FAILED — receipt $RECEIPT"
  printf 'asmt-gate: pass (%s)\n' "$SHA"
}

cmd_check() {
  [ -f "$RECEIPT" ] || die "no receipt for HEAD $SHA. Run asmt-gate run."
  grep -q '"result":"pass"' "$RECEIPT" || die "last gate run on $SHA failed."
  printf 'asmt-gate: receipt ok (%s)\n' "$SHA"
}

case "${1:-run}" in
  run)   cmd_run ;;
  check) cmd_check ;;
  *)     die "usage: asmt-gate [run|check]" ;;
esac
