#!/usr/bin/env bash
# Behavioural tests for plugins/asmt/bin/asmt-plan.
# See specs/changes/task-planning/spec.md.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
PLAN="$ROOT/plugins/asmt/bin/asmt-plan"

fails=0
ok()  { printf 'ok   - %s\n' "$1"; }
bad() { printf 'FAIL - %s\n' "$1"; fails=$((fails + 1)); }

# A change directory holding whatever spec.md and tasks.md the case needs.
# Nothing here touches git — cover reads two files and answers.
new_change() {
  local dir
  dir="$(mktemp -d)"
  printf '%s' "$dir"
}

write_spec() { printf '%s\n' "$2" > "$1/spec.md"; }
write_tasks() { printf '%s\n' "$2" > "$1/tasks.md"; }

# Captures stdout+stderr and the exit code of one cover run.
out=""; code=0
cover()    { out="$("$PLAN" cover "$1" 2>&1)"; code=$?; }
precheck() { out="$("$PLAN" precheck "$1" 2>&1)"; code=$?; }

SPEC_TWO='Signed off: tester, 2026-08-07

# Spec: sample

## ADDED REQ-1: The thing works

### REQ-1.1

Given a case, when it runs, it works.

### REQ-1.2

Given another case, when it runs, it also works.'

# REQ-4.2: every scenario claimed by a task -> cover passes.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: do it

Satisfies: REQ-1.1, REQ-1.2'
cover "$c"
if [ "$code" -eq 0 ]; then
  ok "REQ-4.2: full coverage passes"
else
  bad "REQ-4.2: full coverage should pass, got exit $code: $out"
fi
rm -rf "$c"

# REQ-4.1: a scenario no task names -> cover fails and names it.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: do half of it

Satisfies: REQ-1.1'
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-4.1: an uncovered scenario fails cover"
else
  bad "REQ-4.1: uncovered REQ-1.2 should fail cover, got exit 0"
fi
case "$out" in
  *REQ-1.2*) ok "REQ-4.1: the failure names the uncovered scenario" ;;
  *)         bad "REQ-4.1: failure did not name REQ-1.2: $out" ;;
esac
rm -rf "$c"

# REQ-4.3: a task claiming an id the spec does not contain -> cover fails
# and names it. A typo in a Satisfies: line must not read as coverage.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: do it

Satisfies: REQ-1.1, REQ-1.2, REQ-9.9'
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-4.3: an unknown claimed id fails cover"
else
  bad "REQ-4.3: unknown REQ-9.9 should fail cover, got exit 0"
fi
case "$out" in
  *REQ-9.9*) ok "REQ-4.3: the failure names the unknown id" ;;
  *)         bad "REQ-4.3: failure did not name REQ-9.9: $out" ;;
esac
rm -rf "$c"

# REQ-4.4: REQ-1.10 does not satisfy REQ-1.1 — matching is delimited on
# both sides, exactly as tdd-loop matches test names.
c="$(new_change)"
write_spec "$c" 'Signed off: tester, 2026-08-07

## ADDED REQ-1: The thing works

### REQ-1.1

Given a case, when it runs, it works.

### REQ-1.10

Given the tenth case, when it runs, it works.'
write_tasks "$c" '## T-1: do the tenth only

Satisfies: REQ-1.10'
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-4.4: REQ-1.10 alone does not cover REQ-1.1"
else
  bad "REQ-4.4: REQ-1.10 should not satisfy REQ-1.1, got exit 0"
fi
case "$out" in
  *REQ-1.1*) ok "REQ-4.4: the failure names REQ-1.1 as uncovered" ;;
  *)         bad "REQ-4.4: failure did not name REQ-1.1: $out" ;;
esac
rm -rf "$c"

# REQ-4.5: no tasks.md at all -> cover fails rather than passing vacuously.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-4.5: a missing tasks.md fails cover"
else
  bad "REQ-4.5: missing tasks.md should fail cover, got exit 0"
fi
rm -rf "$c"

# REQ-2.1: task ids run T-1, T-2, ... in sequence. A gap means an id was
# invented or a task was deleted by hand, and either way the plan no longer
# says what it appears to say.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: first

Satisfies: REQ-1.1

## T-3: third, with no second

Satisfies: REQ-1.2'
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-2.1: a gap in the task sequence fails cover"
else
  bad "REQ-2.1: T-1 followed by T-3 should fail cover, got exit 0"
fi
case "$out" in
  *T-3*|*T-2*) ok "REQ-2.1: the failure names the broken position" ;;
  *)           bad "REQ-2.1: failure named neither T-2 nor T-3: $out" ;;
esac
rm -rf "$c"

# REQ-2.1: ids starting somewhere other than T-1 fail too.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-2: starts at two

Satisfies: REQ-1.1, REQ-1.2'
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-2.1: a sequence not starting at T-1 fails cover"
else
  bad "REQ-2.1: sequence starting at T-2 should fail cover, got exit 0"
fi
rm -rf "$c"

# REQ-3.1: a task with no Satisfies: line at all fails, and is named. An
# omitted line is a defect, never an implicit "nothing".
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: covers everything

Satisfies: REQ-1.1, REQ-1.2

## T-2: says nothing about what it proves'
cover "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-3.1: a task with no Satisfies: line fails cover"
else
  bad "REQ-3.1: missing Satisfies: should fail cover, got exit 0"
fi
case "$out" in
  *T-2*) ok "REQ-3.1: the failure names the task missing the line" ;;
  *)     bad "REQ-3.1: failure did not name T-2: $out" ;;
esac
rm -rf "$c"

# REQ-3.2: `Satisfies: none` is a real answer — an enabling task that proves
# no scenario of its own passes, as long as the scenarios are covered
# elsewhere.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: covers everything

Satisfies: REQ-1.1, REQ-1.2

## T-2: makes the next task possible

Satisfies: none'
cover "$c"
if [ "$code" -eq 0 ]; then
  ok "REQ-3.2: Satisfies: none passes cover"
else
  bad "REQ-3.2: Satisfies: none should pass, got exit $code: $out"
fi
rm -rf "$c"

# --- precheck: what must be true before a plan may be written ------------

# A signed-off spec with no plan yet is the ordinary case precheck exists to
# approve.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
precheck "$c"
if [ "$code" -eq 0 ]; then
  ok "REQ-1.1: a signed-off spec with no plan yet passes precheck"
else
  bad "REQ-1.1: signed-off spec should pass precheck, got exit $code: $out"
fi
rm -rf "$c"

# REQ-1.1: no Signed off: line anywhere -> refuse to plan, and say why.
c="$(new_change)"
write_spec "$c" '# Spec: sample

## ADDED REQ-1: The thing works

### REQ-1.1

Given a case, when it runs, it works.'
precheck "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-1.1: an unsigned spec fails precheck"
else
  bad "REQ-1.1: unsigned spec should fail precheck, got exit 0"
fi
case "$out" in
  *"Signed off"*) ok "REQ-1.1: the failure names the missing sign-off line" ;;
  *)              bad "REQ-1.1: failure did not mention the sign-off line: $out" ;;
esac
rm -rf "$c"

# REQ-1.2: the line exists but further down the file. The grammar defines
# sign-off as the first line; a line buried in the body is prose, not a
# signature, and treating it as one would let anyone sign by mentioning it.
c="$(new_change)"
write_spec "$c" '# Spec: sample

Signed off: tester, 2026-08-07

### REQ-1.1

Given a case, when it runs, it works.'
precheck "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-1.2: a sign-off line that is not the first line fails precheck"
else
  bad "REQ-1.2: non-first-line sign-off should fail precheck, got exit 0"
fi
rm -rf "$c"

# REQ-1.3: no spec.md at all -> fail, naming the path it looked for, so the
# answer to "planning what?" is in the message rather than in the reader's
# head.
c="$(new_change)"
precheck "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-1.3: a change directory with no spec.md fails precheck"
else
  bad "REQ-1.3: missing spec.md should fail precheck, got exit 0"
fi
case "$out" in
  *"$c/spec.md"*) ok "REQ-1.3: the failure names the path it looked for" ;;
  *)              bad "REQ-1.3: failure did not name $c/spec.md: $out" ;;
esac
rm -rf "$c"

# REQ-5.1: a plan with work already done may not be replanned. Regenerating
# a task list under a half-built change orphans commits that name task ids
# nothing points at any more.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: already built

- [x] Complete

Satisfies: REQ-1.1

## T-2: not yet

- [ ] Complete

Satisfies: REQ-1.2'
before="$(md5sum < "$c/tasks.md")"
precheck "$c"
if [ "$code" -ne 0 ]; then
  ok "REQ-5.1: a plan with a completed task fails precheck"
else
  bad "REQ-5.1: completed task should fail precheck, got exit 0"
fi
case "$out" in
  *T-1*) ok "REQ-5.1: the failure names the completed task" ;;
  *)     bad "REQ-5.1: failure did not name T-1: $out" ;;
esac
if [ "$(md5sum < "$c/tasks.md")" = "$before" ]; then
  ok "REQ-5.1: tasks.md is left byte-for-byte unchanged"
else
  bad "REQ-5.1: precheck modified tasks.md"
fi
rm -rf "$c"

# REQ-5.2: nothing started yet -> replanning is safe, so precheck approves it.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" '## T-1: not started

- [ ] Complete

Satisfies: REQ-1.1, REQ-1.2'
precheck "$c"
if [ "$code" -eq 0 ]; then
  ok "REQ-5.2: a plan with nothing completed passes precheck"
else
  bad "REQ-5.2: untouched plan should pass precheck, got exit $code: $out"
fi
rm -rf "$c"

# --- next / complete: where the build is up to -----------------------------

PLAN_THREE='## T-1: first

- [ ] Complete

Satisfies: REQ-1.1

## T-2: second

- [ ] Complete

Satisfies: REQ-1.2

## T-3: third

- [ ] Complete

Satisfies: none'

# REQ-6.1: completing a task ticks that task and no other. The tick means a
# commit has landed, so a command does it — a model claiming to have ticked
# it is the exact class of claim this project replaces with a fact.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" "$PLAN_THREE"
"$PLAN" complete "$c" T-2 >/dev/null 2>&1
code=$?
if [ "$code" -eq 0 ]; then
  ok "REQ-6.1: completing a task exits 0"
else
  bad "REQ-6.1: complete T-2 should exit 0, got $code"
fi
if [ "$(grep -c '^- \[x\] Complete' "$c/tasks.md")" -eq 1 ]; then
  ok "REQ-6.1: exactly one task is ticked"
else
  bad "REQ-6.1: expected exactly one ticked box, got $(grep -c '^- \[x\] Complete' "$c/tasks.md")"
fi
if sed -n '/^## T-2:/,/^## T-3:/p' "$c/tasks.md" | grep -q '^- \[x\] Complete'; then
  ok "REQ-6.1: the ticked task is the one named"
else
  bad "REQ-6.1: T-2 is not the task that got ticked"
fi
rm -rf "$c"

# REQ-6.2: the build resumes at the first task not ticked, not at the first
# task. Anything else re-does finished work after an interruption.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" "$PLAN_THREE"
"$PLAN" complete "$c" T-1 >/dev/null 2>&1
out="$("$PLAN" next "$c" 2>/dev/null)"
if [ "$out" = "T-2" ]; then
  ok "REQ-6.2: next names the first task not marked complete"
else
  bad "REQ-6.2: next should name T-2, got '$out'"
fi
rm -rf "$c"

# REQ-6.2: a gap in completion order still resumes at the earliest unticked
# task, not after the last ticked one.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" "$PLAN_THREE"
"$PLAN" complete "$c" T-2 >/dev/null 2>&1
out="$("$PLAN" next "$c" 2>/dev/null)"
if [ "$out" = "T-1" ]; then
  ok "REQ-6.2: next skips a later completed task and names the earliest open one"
else
  bad "REQ-6.2: with only T-2 done, next should name T-1, got '$out'"
fi
rm -rf "$c"

# REQ-6.3: nothing left to do -> say so and start nothing. Empty stdout is
# what the caller branches on; the explanation goes to stderr.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" "$PLAN_THREE"
"$PLAN" complete "$c" T-1 >/dev/null 2>&1
"$PLAN" complete "$c" T-2 >/dev/null 2>&1
"$PLAN" complete "$c" T-3 >/dev/null 2>&1
out="$("$PLAN" next "$c" 2>/dev/null)"
err="$("$PLAN" next "$c" 2>&1 >/dev/null)"
if [ -z "$out" ]; then
  ok "REQ-6.3: a finished plan names no next task"
else
  bad "REQ-6.3: finished plan should name nothing, got '$out'"
fi
case "$err" in
  *finished*|*complete*) ok "REQ-6.3: a finished plan says so" ;;
  *)                     bad "REQ-6.3: no message that the plan is finished: $err" ;;
esac
rm -rf "$c"

# Completing a task that is not in the plan is a mistake worth hearing about,
# not a silent no-op that leaves the caller believing progress was recorded.
c="$(new_change)"
write_spec "$c" "$SPEC_TWO"
write_tasks "$c" "$PLAN_THREE"
if "$PLAN" complete "$c" T-9 >/dev/null 2>&1; then
  bad "REQ-6.1: completing a task not in the plan should fail"
else
  ok "REQ-6.1: completing a task not in the plan fails"
fi
rm -rf "$c"

[ "$fails" -eq 0 ] || printf '\n%s assertion(s) failed\n' "$fails"
exit "$((fails > 0))"
