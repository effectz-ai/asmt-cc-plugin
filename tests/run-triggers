#!/usr/bin/env bash
# run-triggers — do the entry-point skills actually fire on the phrasings a
# person would type? Every case spawns a real nested `claude -p` session, so
# this costs wall-clock and tokens and is deliberately NOT named test-*:
# tests/run-all globs that pattern, and the verification gate must stay fast,
# offline and free.
#
# The offline half — deciding a case from a captured log — is a mode of this
# same script (`--judge`), so tests/test-trigger-runner exercises the code that
# really runs rather than a copy of it.
set -uo pipefail

ATTEMPTS="${ASMT_TRIGGER_ATTEMPTS:-3}"

# Captured before any sandbox overrides HOME, so the credential copy below can
# still find the real profile.
REAL_HOME="${USERPROFILE:-$HOME}"

die() { printf 'run-triggers: %s\n' "$*" >&2; exit 1; }

# Skills invoked in a captured stream-json session log, one per line, in the
# order they appear.
#
# ponytail: grep over the log rather than a JSON parser — jq is not a
# dependency we want, and the field is emitted on one line. The ceiling is a
# harness that starts pretty-printing stream-json across lines; the fix then is
# a real parser, not a cleverer regex.
skills_fired() {
  grep -ao '"skill":"[^"]*"' "$1" 2>/dev/null \
    | sed -e 's/^"skill":"//' -e 's/"$//' \
    | sort -u
}

# Did $2 fire, as a whole skill name? The plugin namespace prefix is optional,
# so `spec` and `asmt:spec` are the same skill — but `spec-grammar` is not,
# which is why this compares whole names instead of searching for a substring.
skill_in() {
  local fired="$1" want="$2" name
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    [ "$name" = "$want" ] && return 0
    [ "${name##*:}" = "$want" ] && return 0
  done <<< "$fired"
  return 1
}

# Decide one case from its captured log. Exit 0 when the case passes.
cmd_judge() {
  local log="${1:-}" skill="${2:-}" expectation="${3:-}" fired verdict
  [ -n "$log" ] && [ -n "$skill" ] && [ -n "$expectation" ] \
    || die "usage: run-triggers --judge <log> <skill> <should-fire|should-not-fire>"
  [ -f "$log" ] || die "no such log: $log"

  fired="$(skills_fired "$log")"
  printf 'skills fired: %s\n' "${fired:-none}" | tr '\n' ' '
  printf '\n'

  case "$expectation" in
    should-fire)
      skill_in "$fired" "$skill" && verdict=0 || verdict=1
      ;;
    should-not-fire)
      skill_in "$fired" "$skill" && verdict=1 || verdict=0
      ;;
    *)
      die "unknown expectation: $expectation"
      ;;
  esac
  return "$verdict"
}

HERE="$(cd "$(dirname "$0")" && pwd)"
CASES="${ASMT_TRIGGER_CASES:-$HERE/triggers}"

# Every case, one per line: `<skill> <expectation> <path>`.
#
# A case's location is its assertion — tests/triggers/<skill>/<expectation>/*.txt
# — so adding a phrasing is adding a file, with nothing to register anywhere.
# An expectation directory we do not recognise is a typo that would otherwise
# be silently skipped forever, so it is an error rather than a shrug.
cmd_list() {
  local file rel skill expectation
  [ -d "$CASES" ] || die "no case directory at $CASES"

  while IFS= read -r file; do
    rel="${file#"$CASES"/}"
    skill="${rel%%/*}"
    expectation="${rel#*/}"
    expectation="${expectation%%/*}"
    case "$expectation" in
      should-fire|should-not-fire) ;;
      *) die "unknown expectation directory '$expectation' in $file" ;;
    esac
    printf '%s %s %s\n' "$skill" "$expectation" "$file"
  done < <(find "$CASES" -name '*.txt' | sort)
}

PLUGIN_DIR="$(cd "$HERE/../plugins/asmt" && pwd)"

# One attempt: run the prompt in $1, write the session log to $2.
#
# The whole command is replaceable through ASMT_TRIGGER_CMD, which is the seam
# the offline tests use — a fake can record the environment it was handed and
# emit a canned log, so isolation, retry and skip behaviour are all testable
# without spending a token.
# Both branches take stdin from /dev/null. The caller drives these from a
# `while read` loop, and a nested session inherits that stdin and drains it —
# which silently ate every case after the first until a real run exposed it.
attempt() {
  local prompt_file="$1" log_file="$2"
  if [ -n "${ASMT_TRIGGER_CMD:-}" ]; then
    "$ASMT_TRIGGER_CMD" "$prompt_file" "$log_file" < /dev/null
    return $?
  fi
  # --verbose is not optional here: --print with stream-json is rejected
  # without it.
  timeout 300 claude -p "$(cat "$prompt_file")" \
    --plugin-dir "$PLUGIN_DIR" \
    --dangerously-skip-permissions \
    --max-turns 3 \
    --output-format stream-json \
    --verbose \
    < /dev/null \
    > "$log_file" 2>&1
}

# The throwaway project a case runs against.
#
# An empty directory is not a realistic target, and pretending otherwise
# produced false failures: asked to spec a rate limiter in a directory holding
# nothing at all, a session sensibly asks what the project even is rather than
# invoking anything. So the sandbox gets the minimum that makes the prompts
# coherent — an ASMT config, and one change whose spec is signed off but not
# yet planned. That state is deliberate: it is the point where /asmt:plan is
# the right next move and /asmt:build is not.
seed_project() {
  local p="$1"
  mkdir -p "$p/.asmt" "$p/specs/current" "$p/specs/changes/caching"

  cat > "$p/.asmt/config.yml" <<'YML'
version: 1
modes:
  artifacts: living
  loop: tdd
  topology: sequential
default_size_class: standard
verify:
  command: "npm test"
paths:
  changes: "specs/changes"
  living:  "specs/current"
YML

  cat > "$p/specs/changes/caching/proposal.md" <<'MD'
# Proposal: response caching

Repeated identical reads hit the database every time. Cache them.

## What this explicitly does not do

No cache invalidation on write — a later change.
MD

  cat > "$p/specs/changes/caching/spec.md" <<'MD'
Signed off: tester, 2026-08-07

# Spec: response caching

## ADDED REQ-1: Identical reads are served from cache

### REQ-1.1

Given a read served once, when the same read arrives again within the TTL,
then it is answered from cache without touching the database.
MD

  git -C "$p" init -q 2>/dev/null || true
  git -C "$p" config core.autocrlf false 2>/dev/null || true
}

# Runs one case in a sandbox and returns the judge's verdict.
#
# The sandbox is the point. These sessions run with permissions skipped, so
# they get a HOME with no plugin installed in it (ours arrives via
# --plugin-dir, and nothing else should be competing) and a throwaway working
# directory that is not this repository. Anything the session decides to
# create, it creates there.
run_case() {
  local skill="$1" expectation="$2" prompt_file="$3" log_file="$4"
  local sandbox rc
  sandbox="$(mktemp -d)"
  mkdir -p "$sandbox/home/.claude" "$sandbox/project"
  seed_project "$sandbox/project"

  # Isolation and authentication pull in opposite directions: credentials live
  # in the same profile directory the other plugins are installed in, so a
  # fully empty HOME produced sixteen "Not logged in" skips. Copy the one file
  # that carries credentials and nothing else — the plugin roster, settings and
  # history stay out, which is what the isolation is actually for.
  if [ -z "${ASMT_TRIGGER_CMD:-}" ] && [ -f "$REAL_HOME/.claude/.credentials.json" ]; then
    cp "$REAL_HOME/.claude/.credentials.json" "$sandbox/home/.claude/" 2>/dev/null || true
  fi
  (
    cd "$sandbox/project" || exit 1
    # USERPROFILE as well as HOME: on Windows the CLI resolves its config from
    # USERPROFILE, so setting HOME alone left every other installed plugin
    # loaded in a session that was supposed to be isolated.
    HOME="$sandbox/home" USERPROFILE="$sandbox/home" \
      attempt "$prompt_file" "$log_file"
  )
  rc=$?
  rm -rf "$sandbox"

  # A non-zero exit does not mean the question went unanswered. A session that
  # hits --max-turns exits non-zero having already invoked the skill, and
  # discarding that log called a firing skill a failure. So: judge whatever was
  # captured, and only treat the attempt as unusable when it produced nothing.
  if [ ! -s "$log_file" ]; then
    [ "$rc" -eq 0 ] && return 2
    looks_unauthenticated "$log_file" && return 3
    return 2
  fi
  if [ "$rc" -ne 0 ] && looks_unauthenticated "$log_file"; then
    return 3                                        # skip: tells us nothing
  fi
  cmd_judge "$log_file" "$skill" "$expectation" >/dev/null 2>&1
}

# Did this attempt fail because nobody is logged in, rather than because
# anything about our descriptions is wrong?
#
# ponytail: a fixed list of phrases, matched case-insensitively. The CLI
# promises nothing about its error text, so this is narrow on purpose — an
# unrecognised failure stays a failure, because turning every non-zero exit
# into a skip would let a broken runner report green. The ceiling is a
# reworded auth error, which shows up as a confusing failure rather than a
# silent pass; the upgrade path is a stable exit code from the CLI.
# -a because these logs contain control characters and grep otherwise decides
# they are binary — at which point -q still matches but -o prints nothing, so
# the same file both "contains an auth error" and "lists no skills". That
# combination produced false skips and false failures in the first real run.
#
# The phrase list is narrower than it was: 'authentication' and '401' appear in
# ordinary session chatter, and matching them turned working cases into skips.
looks_unauthenticated() {
  grep -qaiE 'invalid api key|please run /login|not logged in|credit balance is too low|usage limit|spend limit' "$1" 2>/dev/null
}

cmd_run() {
  local runs skill expectation prompt_file log_file name rc tries failed=0 skipped=0 flaky=0 n=0

  # A machine with no CLI cannot run these tests. That is not the same as tests
  # that failed, and reporting it as red gives someone a job they cannot do.
  if [ -z "${ASMT_TRIGGER_CMD:-}" ] && ! command -v claude >/dev/null 2>&1; then
    printf 'skip - no claude executable on PATH; trigger cases not run\n'
    return 0
  fi

  runs="$(mktemp -d)"
  printf 'run-triggers: logs in %s\n\n' "$runs"

  while read -r skill expectation prompt_file; do
    [ -n "$skill" ] || continue
    n=$((n + 1))
    name="$(basename "$prompt_file" .txt)"

    # Retry only on failure. The same prompt can fail once and pass the next
    # time, so one bad attempt is not evidence about a description — but a case
    # that needs three goes is a weak description, which is why the attempt
    # count is reported rather than swallowed. A first-attempt pass costs
    # exactly one session; retrying everything would multiply the suite's cost
    # to learn nothing about the cases that already work.
    tries=0
    while :; do
      tries=$((tries + 1))
      log_file="$runs/${skill}-${expectation}-${name}.attempt-${tries}.json"
      run_case "$skill" "$expectation" "$prompt_file" "$log_file"
      rc=$?
      [ "$rc" -eq 0 ] && break
      [ "$rc" -eq 3 ] && break              # unauthenticated: retrying cannot help
      [ "$tries" -ge "$ATTEMPTS" ] && break
    done

    case "$rc" in
      0) if [ "$tries" -gt 1 ]; then
           printf 'flaky- %s %s %s (passed on %s attempts)\n' \
             "$skill" "$expectation" "$name" "$tries"
           flaky=$((flaky + 1))
         else
           printf 'ok   - %s %s %s\n' "$skill" "$expectation" "$name"
         fi ;;
      3) printf 'skip - %s %s %s (session could not authenticate)\n' "$skill" "$expectation" "$name"
         skipped=$((skipped + 1)) ;;
      # Name the log on the failure line itself. A phrasing that did not fire
      # is only diagnosable from the session it produced, and re-running to see
      # it again costs another nested session.
      *) printf 'FAIL - %s %s %s (log: %s)\n' "$skill" "$expectation" "$name" "$log_file"
         failed=$((failed + 1)) ;;
    esac
  done < <(cmd_list)

  printf '\n%s case(s), %s failed, %s skipped\n' "$n" "$failed" "$skipped"
  [ "$failed" -eq 0 ]
}

case "${1:-}" in
  --judge) shift; cmd_judge "$@" ;;
  --list)  shift; cmd_list "$@" ;;
  --run|"") shift 2>/dev/null || true; cmd_run ;;
  *)       die "usage: run-triggers [--run|--list|--judge <log> <skill> <expectation>]" ;;
esac
