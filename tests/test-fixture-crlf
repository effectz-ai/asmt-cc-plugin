#!/usr/bin/env bash
# Regression tests for the CRLF-warning noise from tests/fixtures.sh's
# new_repo(). See specs/current/test-fixtures.md (folded from
# specs/changes/archive/quiet-fixture-crlf/).
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=fixtures.sh
. "$HERE/fixtures.sh"

fails=0
ok()  { printf 'ok   - %s\n' "$1"; }
bad() { printf 'FAIL - %s\n' "$1"; fails=$((fails + 1)); }

# REQ-1.1: new_repo()'s own init/commit prints no CRLF warning.
err1="$(mktemp)"
repo="$(new_repo true 2>"$err1")"
if grep -q 'will be replaced by CRLF' "$err1"; then
  bad "REQ-1.1: new_repo() init/commit printed a CRLF warning"
else
  ok "REQ-1.1: new_repo() init/commit prints no CRLF warning"
fi
rm -f "$err1"

# REQ-1.2: a later commit into a repo new_repo() already created also
# prints no CRLF warning (mirrors what test-asmt-gate does with new.txt).
err2="$(mktemp)"
( cd "$repo" && echo hi > later.txt && git add -A && git commit -qm "later" ) 2>"$err2"
if grep -q 'will be replaced by CRLF' "$err2"; then
  bad "REQ-1.2: later commit into a fixture repo printed a CRLF warning"
else
  ok "REQ-1.2: later commit into a fixture repo prints no CRLF warning"
fi
rm -f "$err2"


# REQ-1.3: the real tests/run-all, run end to end, has zero CRLF warnings
# in its combined output. This is the regression net — REQ-1.1/REQ-1.2
# test the helper in isolation and would stay green even if some other
# path started leaking the warning back in. This file is itself one of
# run-all's test-* files, so a naive re-invocation from here would recurse
# forever; ASMT_SUITE_NESTED marks "already inside the REQ-1.3 check" so
# the nested run-all still executes every other test-* file for real (the
# output inspected is genuinely the whole suite's), it just skips this
# block on its way back through this same file.
if [ -z "${ASMT_SUITE_NESTED:-}" ]; then
  # Spawns a full nested tests/run-all — this is where suite time roughly
  # doubles; look here first, not just in tasks.md, when chasing it down.
  full_out="$(ASMT_SUITE_NESTED=1 "$HERE/run-all" 2>&1)"
  if printf '%s' "$full_out" | grep -q 'will be replaced by CRLF'; then
    bad "REQ-1.3: full tests/run-all output contains a CRLF warning"
  else
    ok "REQ-1.3: full tests/run-all output contains no CRLF warning"
  fi
else
  ok "REQ-1.3: skipped in nested run (avoids recursing into run-all again)"
fi

[ "$fails" -eq 0 ] || printf '\n%s assertion(s) failed\n' "$fails"
exit "$((fails > 0))"
