#!/usr/bin/env bash
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
# Overridable so a test can prove a fix red against the previous binary.
GATE="${ASMT_GATE_BIN:-$HERE/../plugins/asmt/bin/asmt-gate}"
# shellcheck source=fixtures.sh
. "$HERE/fixtures.sh"

fails=0
ok()   { printf 'ok   - %s\n' "$1"; }
bad()  { printf 'FAIL - %s\n' "$1"; fails=$((fails + 1)); }
is()   { [ "$2" = "$3" ] && ok "$1" || bad "$1 (expected '$3', got '$2')"; }

run_in() { ( cd "$1" && shift && "$GATE" "$@" >/dev/null 2>&1 ); echo $?; }

# 1. passing verify command exits 0
repo="$(new_repo true)"
is "run: passing command exits 0" "$(run_in "$repo" run)" "0"

# 2. and writes a pass receipt keyed to HEAD
sha="$(head_sha "$repo")"
receipt="$repo/.asmt/receipts/$sha.json"
[ -f "$receipt" ] && ok "run: receipt written at HEAD sha" || bad "run: no receipt at $receipt"
grep -q '"result":"pass"' "$receipt" 2>/dev/null \
  && ok "run: receipt records pass" || bad "run: receipt missing pass result"

# 3. check accepts a fresh pass receipt
is "check: accepts fresh pass receipt" "$(run_in "$repo" check)" "0"

# 4. a new commit invalidates the receipt
( cd "$repo" && echo hi > new.txt && git add -A && git commit -qm "second" )
is "check: rejects receipt after new commit" "$(run_in "$repo" check)" "1"

# 5. failing verify command exits 1 and records the failure
repo_fail="$(new_repo false)"
is "run: failing command exits 1" "$(run_in "$repo_fail" run)" "1"
grep -q '"result":"fail"' "$repo_fail/.asmt/receipts/$(head_sha "$repo_fail").json" 2>/dev/null \
  && ok "run: receipt records fail" || bad "run: receipt missing fail result"

# 6. dirty tree is refused, and no receipt is written
repo_dirty="$(new_repo true)"
echo dirty > "$repo_dirty/uncommitted.txt"
is "run: refuses dirty tree" "$(run_in "$repo_dirty" run)" "1"
[ -f "$repo_dirty/.asmt/receipts/$(head_sha "$repo_dirty").json" ] \
  && bad "run: wrote a receipt for a dirty tree" || ok "run: no receipt for dirty tree"

# 7. check with no receipt at all, and run with no config
repo_bare="$(new_repo true)"
is "check: rejects missing receipt" "$(run_in "$repo_bare" check)" "1"
rm "$repo_bare/.asmt/config.yml"
is "run: rejects missing config" "$(run_in "$repo_bare" run)" "1"

# 8. receipt JSON escapes backslashes and quotes in the command
repo_esc="$(new_repo true)"
cat > "$repo_esc/.asmt/config.yml" <<'CFG'
version: 1

verify:
  command: true "x\y" z
  timeout_seconds: 900
CFG
( cd "$repo_esc" && git add -A && git commit -qm "escaping fixture" )
is "run: passing command with backslash+quote exits 0" "$(run_in "$repo_esc" run)" "0"
esc_receipt="$repo_esc/.asmt/receipts/$(head_sha "$repo_esc").json"
grep -qF '"command":"true \"x\\y\" z"' "$esc_receipt" 2>/dev/null \
  && ok "run: receipt escapes backslash and quote correctly" \
  || bad "run: receipt command field not correctly escaped (got: $(cat "$esc_receipt" 2>/dev/null))"

# 9. ambiguous verify.command (multiple `command:` lines) fails closed via
# asmt-gate's own die(), not a raw pipeline abort under set -e/pipefail.
repo_ambig="$(new_repo true)"
cat > "$repo_ambig/.asmt/config.yml" <<'CFG'
version: 1

verify:
  command: "true"
  command: "false"
  timeout_seconds: 900
CFG
( cd "$repo_ambig" && git add -A && git commit -qm "ambiguous fixture" )
ambig_out="$( ( cd "$repo_ambig" && "$GATE" run ) 2>&1 )"
ambig_rc=$?
is "run: refuses ambiguous verify.command" "$ambig_rc" "1"
printf '%s' "$ambig_out" | grep -q '^asmt-gate: ambiguous' \
  && ok "run: ambiguous command dies with asmt-gate's own message, not a raw abort" \
  || bad "run: ambiguous command did not produce asmt-gate's controlled die message, got: $ambig_out"

# 10. verify: block present but no command: key (0 matches) fails closed
# with the intended die() message, not a silent set -e abort.
repo_nocmd="$(new_repo true)"
cat > "$repo_nocmd/.asmt/config.yml" <<'CFG'
version: 1

verify:
  timeout_seconds: 900
CFG
( cd "$repo_nocmd" && git add -A && git commit -qm "no-command fixture" )
nocmd_out="$( ( cd "$repo_nocmd" && "$GATE" run ) 2>&1 )"
nocmd_rc=$?
is "run: refuses config with no command key" "$nocmd_rc" "1"
printf '%s' "$nocmd_out" | grep -q 'verify.command missing from' \
  && ok "run: missing-command config dies with the intended message" \
  || bad "run: missing-command config did not produce the intended die message, got: $nocmd_out"

# 11. verify.timeout_seconds is honoured: a command that outlives the
# configured timeout is killed, the run is treated as a failure, and the
# receipt records it — proving the key isn't decoration.
repo_slow="$(new_repo true)"
cat > "$repo_slow/.asmt/config.yml" <<'CFG'
version: 1

verify:
  command: "sleep 5"
  timeout_seconds: 1
CFG
( cd "$repo_slow" && git add -A && git commit -qm "slow verify fixture" )
slow_start=$(date +%s)
is "run: kills a command that exceeds timeout_seconds" "$(run_in "$repo_slow" run)" "1"
slow_elapsed=$(( $(date +%s) - slow_start ))
[ "$slow_elapsed" -lt 5 ] \
  && ok "run: timeout actually killed the command (took ${slow_elapsed}s, not ~5s)" \
  || bad "run: command ran to completion instead of being killed (took ${slow_elapsed}s)"
grep -q '"result":"fail"' "$repo_slow/.asmt/receipts/$(head_sha "$repo_slow").json" 2>/dev/null \
  && ok "run: timed-out command's receipt records fail" \
  || bad "run: timed-out command's receipt missing fail result"

# 12. a config with no timeout_seconds key still runs unbounded, unchanged
# from before the key was wired up.
repo_notimeout="$(new_repo true)"
cat > "$repo_notimeout/.asmt/config.yml" <<'CFG'
version: 1

verify:
  command: "true"
CFG
( cd "$repo_notimeout" && git add -A && git commit -qm "no-timeout fixture" )
is "run: absent timeout_seconds does not break the run" "$(run_in "$repo_notimeout" run)" "0"


# --- portability: no GNU coreutils (macOS) ---------------------------------
#
# Observed on macOS: `timeout: command not found` made the subshell exit 127,
# so the gate recorded "result":"fail","seconds":0 having never run the verify
# command at all. It failed closed, which is the right direction, but a gate
# that reports failure without running anything is still lying.
#
# ASMT_TIMEOUT_BIN is a test seam: the gate resolves timeout/gtimeout into it,
# and setting it empty simulates a machine that has neither.

# REQ-1.1: with no timeout binary available, the verify command still runs and
# its own exit status decides the result.
#
# Simulated with the ASMT_TIMEOUT_BIN seam rather than by stripping PATH: on
# Cygwin a pared-down PATH cannot load the DLLs bash itself needs, so the shell
# dies before the gate runs and the test proves nothing. The static assertion
# below covers what the seam cannot — that the gate resolves a binary instead
# of calling one blind, which is the actual macOS bug.
repo_notimeout_pass="$(new_repo true)"
out="$(cd "$repo_notimeout_pass" && ASMT_TIMEOUT_BIN="" "$GATE" run 2>&1)"
code=$?
if [ "$code" -eq 0 ]; then
  ok "REQ-1.1: gate passes with no timeout binary available"
else
  bad "REQ-1.1: gate should pass without a timeout binary, got $code: $out"
fi
receipt="$repo_notimeout_pass/.asmt/receipts/$(head_sha "$repo_notimeout_pass").json"
if grep -q '"result":"pass"' "$receipt" 2>/dev/null; then
  ok "REQ-1.1: the receipt records the verify command's own result"
else
  bad "REQ-1.1: receipt did not record a pass: $(cat "$receipt" 2>/dev/null)"
fi

repo_notimeout_fail="$(new_repo false)"
( cd "$repo_notimeout_fail" && ASMT_TIMEOUT_BIN="" "$GATE" run >/dev/null 2>&1 )
receipt="$repo_notimeout_fail/.asmt/receipts/$(head_sha "$repo_notimeout_fail").json"
if grep -q '"result":"fail"' "$receipt" 2>/dev/null; then
  ok "REQ-1.1: a genuinely failing command still records a fail"
else
  bad "REQ-1.1: failing command did not record a fail"
fi

# REQ-1.1: and the gate must never call `timeout` without resolving it first.
# This is the assertion that fails against the binary macOS choked on.
if grep -q '[^_A-Za-z]timeout "$timeout_secs"' "$GATE"; then
  bad "REQ-1.1: the gate calls a bare timeout without resolving it"
else
  ok "REQ-1.1: the gate resolves a timeout binary before calling it"
fi

# REQ-1.2: dropping a configured timeout is announced, not silent.
repo_warn="$(new_repo true)"
( cd "$repo_warn" && printf 'verify:\n  command: "true"\n  timeout_seconds: 30\n' > .asmt/config.yml \
    && git add -A && git commit -qm "configure a timeout" )
warn_out="$(cd "$repo_warn" && ASMT_TIMEOUT_BIN="" "$GATE" run 2>&1)"
case "$warn_out" in
  *unbounded*|*"no timeout"*|*"without a timeout"*)
    ok "REQ-1.2: the gate says the run was unbounded" ;;
  *)
    bad "REQ-1.2: dropped timeout was not announced: $warn_out" ;;
esac

# REQ-2.1: the receipt's timestamp survives a date without GNU's -I.
repo_date="$(new_repo true)"
( cd "$repo_date" && "$GATE" run >/dev/null 2>&1 )
receipt="$repo_date/.asmt/receipts/$(head_sha "$repo_date").json"
at="$(sed -n 's/.*"at":"\([^"]*\)".*/\1/p' "$receipt" 2>/dev/null)"
case "$at" in
  ????-??-??T??:??:??Z) ok "REQ-2.1: the receipt carries a UTC ISO-8601 timestamp ($at)" ;;
  *)                    bad "REQ-2.1: timestamp is not portable UTC ISO-8601: '$at'" ;;
esac

[ "$fails" -eq 0 ] || printf '\n%s assertion(s) failed\n' "$fails"
exit "$((fails > 0))"
